# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# scripts: cache directory recreated by sync scripts on demand
scripts/.scrape-cache/

# misc local artifacts
*.log
.tsbuildinfo

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Build-time stash for R2-mirrored data dirs (see scripts/build-with-r2-stash.mjs)
/.r2-stash

# Playwright MCP local cache
/.playwright-mcp

# Claude Code project-local settings
/.claude/

# Root-level screenshots (ad-hoc Playwright captures).
# Public image assets live under public/ and are unaffected.
/*.png

# Supabase CLI local temp
supabase/.temp/

# CBBD raw play-by-play archive (regenerable via scripts/cbbd-ingest.mjs; large)
/data/cbbd/

# Box-EPM build intermediates (regenerable via build-box-epm-features.mjs + compute-box-epm.py)
/scripts/box-epm-features.csv
/scripts/box-epm-pred.csv

# Per-game player box scores (public/data/game-players) — regenerable via
# scripts/pull-player-box-v2.mjs + scripts/export-game-players-json.mjs, and
# served from R2 like the other per-entity dirs. Left untracked because only
# some seasons have been generated so far; drop this rule once the full
# 12-season pull has run, to match how team-games/player-games are tracked.
/public/data/game-players/
__pycache__/
/data/derived/

# Per-player assist connections (public/data/assist-players) — regenerable with
# `node scripts/build-assist-network.mjs`, and nothing reads it yet. Held out of
# history deliberately: it is ~17 MB across thirteen seasons, and the decision
# about whether these derivatives ship in the repo or via R2 has not been made.
# The team-level assist-network.json IS tracked, because a panel already reads it.
/public/data/assist-players/

# Paid-season data staged into the function bundle at build time.
# Generated by scripts/stage-gated-data.mjs — never committed, and never
# published: netlify.toml ships it via [functions] included_files.
gated-data/

# Game Log Explorer corpus — 80 MB in 12 files, rewritten in full by
# scripts/build-game-index.mjs and served from R2 in production. Tracking it
# would write 80 MB into git history on every rebuild.
/public/data/game-index/
